#!/bin/sh
set -eu

branch="$(git branch --show-current)"
worktree_count="$(git worktree list --porcelain | grep -c '^worktree ' || true)"
if [ "$worktree_count" -ne 1 ]; then
    echo "Refusing commit with $worktree_count worktrees; the BC-250 contract permits one." >&2
    exit 1
fi

extra_branches="$(git for-each-ref --format='%(refname:short)' refs/heads/ |
    grep -Ev '^(main|pr-557-merge)$' || true)"
extra_count="$(printf '%s\n' "$extra_branches" | grep -c . || true)"
if [ "$extra_count" -ne 0 ]; then
    echo "Refusing commit with candidate branches; use one disposable scored checkout:" >&2
    echo "$extra_branches" >&2
    exit 1
fi

if [ "$branch" != "pr-557-merge" ]; then
    exit 0
fi

outside_system="$(git diff --cached --name-only --diff-filter=ACMRD |
    grep -Ev '^(AGENTS\.md|\.gitattributes|\.gitignore|\.githooks/|performance/bc250/)' || true)"
if [ -z "$outside_system" ]; then
    exit 0
fi

if [ "${DS4_USER_APPROVED_PROMOTION:-}" != "1" ]; then
    echo "Refusing runtime commit directly to pr-557-merge." >&2
    echo "Staged runtime paths:" >&2
    echo "$outside_system" >&2
    echo "Set DS4_USER_APPROVED_PROMOTION=1 only after explicit user approval of qualifying evidence." >&2
    exit 1
fi

evidence="${DS4_PROMOTION_EVIDENCE:-performance/bc250/evidence/current/verdict.json}"
staged_runtime_diff_sha256="$(git diff --cached --binary -- $outside_system |
    sha256sum | awk '{print $1}')"
if python3 -c 'import sys' >/dev/null 2>&1; then
    python_cmd=python3
elif python -c 'import sys' >/dev/null 2>&1; then
    python_cmd=python
else
    echo "Refusing promotion: Python 3 is unavailable to validate evidence." >&2
    exit 1
fi
"$python_cmd" - "$evidence" "$staged_runtime_diff_sha256" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
staged_hash = sys.argv[2]
if not p.is_file():
    raise SystemExit(f"missing promotion evidence: {p}")
data = json.loads(p.read_text(encoding="utf-8"))
verdict = data.get("verdict")
if verdict not in {"promote_eligible", "user_approved_checkpoint"}:
    raise SystemExit(f"promotion evidence verdict is {verdict!r}")
if not data.get("exactness", {}).get("match"):
    raise SystemExit("promotion evidence does not prove exactness")
if verdict == "user_approved_checkpoint":
    if not data.get("activation", {}).get("proved"):
        raise SystemExit("checkpoint evidence does not prove production activation")
    if not str(data.get("checkpoint_reason", "")).strip():
        raise SystemExit("checkpoint evidence is missing its explicit reason")
    if data.get("staged_runtime_diff_sha256") != staged_hash:
        raise SystemExit("checkpoint evidence does not bind the staged runtime diff")
PY
