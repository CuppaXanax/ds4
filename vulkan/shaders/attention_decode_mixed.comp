#version 460 core
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer OutBuf { float out_val[]; };
layout(set = 0, binding = 1) readonly buffer QBuf { float q_val[]; };
layout(set = 0, binding = 2) readonly buffer RawBuf { float raw_val[]; };
layout(set = 0, binding = 3) readonly buffer CompBuf { float comp_val[]; };
layout(set = 0, binding = 4) readonly buffer MaskBuf { float mask_val[]; };
layout(set = 0, binding = 5) readonly buffer SinkBuf { float sink_val[]; };
layout(push_constant) uniform PC { uint n_raw; uint raw_cap; uint raw_start; uint n_comp; uint comp_f16; uint use_mask; uint n_head; uint head_dim; } pc;
shared float dot_reduce[64];
shared float score[1024];
shared float weight;
shared float denom;
shared float max_score;

uint add_mod(uint a, uint b, uint m) {
    a %= m;
    b %= m;
    return a >= m - b ? a - (m - b) : a + b;
}

float comp_at(uint index) {
    if (pc.comp_f16 == 0u) return comp_val[index];
    uint word = index >> 1u;
    vec2 v = unpackHalf2x16(floatBitsToUint(comp_val[word]));
    return (index & 1u) == 0u ? v.x : v.y;
}

void main() {
    uint lane = gl_LocalInvocationIndex;
    uint h = gl_WorkGroupID.x;
    if (h >= pc.n_head) return;
    uint dim = pc.head_dim;
    uint qbase = h * dim;
    float scale = inversesqrt(float(dim));
    for (uint r = 0u; r < pc.n_raw; r++) {
        uint kbase = add_mod(pc.raw_start, r, pc.raw_cap) * dim;
        float dot = 0.0;
        for (uint d = lane; d < dim; d += 64u) dot += q_val[qbase + d] * raw_val[kbase + d];
        dot_reduce[lane] = dot; barrier();
        for (uint stride = 32u; stride != 0u; stride >>= 1u) {
            if (lane < stride) dot_reduce[lane] += dot_reduce[lane + stride];
            barrier();
        }
        if (lane == 0u) score[r] = dot_reduce[0] * scale;
        barrier();
    }
    for (uint c = 0u; c < pc.n_comp; c++) {
        float add = pc.use_mask != 0u ? mask_val[c] : 0.0;
        float dot = 0.0;
        uint cbase = c * dim;
        if (add > -1.0e20)
            for (uint d = lane; d < dim; d += 64u) dot += q_val[qbase + d] * comp_at(cbase + d);
        dot_reduce[lane] = dot; barrier();
        for (uint stride = 32u; stride != 0u; stride >>= 1u) {
            if (lane < stride) dot_reduce[lane] += dot_reduce[lane + stride];
            barrier();
        }
        if (lane == 0u)
            score[pc.n_raw + c] = add <= -1.0e20 ? -1.0e30 : dot_reduce[0] * scale + add;
        barrier();
    }
    uint total = pc.n_raw + pc.n_comp;
    float lane_max = sink_val[h];
    for (uint i = lane; i < total; i += 64u)
        if (i < pc.n_raw || score[i] > -1.0e20) lane_max = max(lane_max, score[i]);
    dot_reduce[lane] = lane_max;
    barrier();
    for (uint stride = 32u; stride != 0u; stride >>= 1u) {
        if (lane < stride) dot_reduce[lane] = max(dot_reduce[lane], dot_reduce[lane + stride]);
        barrier();
    }
    if (lane == 0u) max_score = dot_reduce[0];
    barrier();
    for (uint i = lane; i < total; i += 64u)
        score[i] = (i >= pc.n_raw && score[i] <= -1.0e20) ? 0.0 : exp(score[i] - max_score);
    float lane_denom = 0.0;
    for (uint i = lane; i < total; i += 64u) lane_denom += score[i];
    dot_reduce[lane] = lane_denom;
    barrier();
    for (uint stride = 32u; stride != 0u; stride >>= 1u) {
        if (lane < stride) dot_reduce[lane] += dot_reduce[lane + stride];
        barrier();
    }
    if (lane == 0u) denom = exp(sink_val[h] - max_score) + dot_reduce[0];
    barrier();
    for (uint d = lane; d < dim; d += 64u) out_val[qbase + d] = 0.0;
    barrier();
    for (uint r = 0u; r < pc.n_raw; r++) {
        uint kbase = add_mod(pc.raw_start, r, pc.raw_cap) * dim;
        if (lane == 0u) weight = score[r];
        barrier();
        for (uint d = lane; d < dim; d += 64u) out_val[qbase + d] += weight * raw_val[kbase + d];
        barrier();
    }
    for (uint c = 0u; c < pc.n_comp; c++) {
        float add = pc.use_mask != 0u ? mask_val[c] : 0.0;
        uint cbase = c * dim;
        if (lane == 0u) {
            weight = add <= -1.0e20 ? 0.0 : score[pc.n_raw + c];
        }
        barrier();
        if (add > -1.0e20)
            for (uint d = lane; d < dim; d += 64u)
                out_val[qbase + d] += weight * comp_at(cbase + d);
        barrier();
    }
    for (uint d = lane; d < dim; d += 64u) out_val[qbase + d] /= denom;
}