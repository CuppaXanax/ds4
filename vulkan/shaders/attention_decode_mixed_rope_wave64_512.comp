#version 460 core
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

/* Exact two-pass decode attention for the production 512-wide head.  Scores
 * retain the ordinary shader's shared score array and reduction order; the
 * value pass keeps eight dimensions per lane in registers and fuses the
 * inverse-RoPE tail without a global readback. */
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer OutBuf { float out_val[]; };
layout(set = 0, binding = 1) readonly buffer QBuf { float q_val[]; };
layout(set = 0, binding = 2) readonly buffer RawBuf { float raw_val[]; };
layout(set = 0, binding = 3) readonly buffer CompBuf { float comp_val[]; };
layout(set = 0, binding = 4) readonly buffer MaskBuf { float mask_val[]; };
layout(set = 0, binding = 5) readonly buffer SinkBuf { float sink_val[]; };
layout(push_constant) uniform PC {
    uint n_raw; uint raw_cap; uint raw_start; uint n_comp;
    uint comp_f16; uint use_mask; uint n_head; uint head_dim;
    uint rope_enable; uint n_rot; uint pos0; uint n_ctx_orig;
    int inverse;
    float freq_base; float freq_scale; float ext_factor; float attn_factor;
    float beta_fast; float beta_slow;
} pc;
shared float score[1024];

uint add_mod(uint a, uint b, uint m) {
    a %= m;
    b %= m;
    return a >= m - b ? a - (m - b) : a + b;
}

float comp_at(uint index) {
    if (pc.comp_f16 == 0u) return comp_val[index];
    uint word = index >> 1u;
    vec2 v = unpackHalf2x16(floatBitsToUint(comp_val[word]));
    return (index & 1u) == 0u ? v.x : v.y;
}

float wave_sum_exact(float value, uint lane) {
    for (uint stride = 32u; stride != 0u; stride >>= 1u) {
        float other = subgroupShuffle(value, min(lane + stride, 63u));
        if (lane < stride) value += other;
    }
    return value;
}

float wave_max_exact(float value, uint lane) {
    for (uint stride = 32u; stride != 0u; stride >>= 1u) {
        float other = subgroupShuffle(value, min(lane + stride, 63u));
        if (lane < stride) value = max(value, other);
    }
    return value;
}

float rope_ramp(float low, float high, uint i0) {
    float y = (float(i0) - low) / max(0.001, high - low);
    return 1.0 - clamp(y, 0.0, 1.0);
}

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint head = gl_WorkGroupID.x;
    if (head >= pc.n_head || pc.head_dim != 512u) return;
    const uint dim = 512u;
    const uint qbase = head * dim;
    const float scale = inversesqrt(float(dim));
    float q[8];
    for (uint k = 0u; k < 8u; k++)
        q[k] = q_val[qbase + lane + 64u * k];

    for (uint r = 0u; r < pc.n_raw; r++) {
        const uint kbase = add_mod(pc.raw_start, r, pc.raw_cap) * dim;
        float dot = 0.0;
        for (uint k = 0u; k < 8u; k++)
            dot += q[k] * raw_val[kbase + lane + 64u * k];
        dot = wave_sum_exact(dot, lane);
        if (lane == 0u) score[r] = dot * scale;
    }
    for (uint c = 0u; c < pc.n_comp; c++) {
        const float add = pc.use_mask != 0u ? mask_val[c] : 0.0;
        const uint cbase = c * dim;
        float dot = 0.0;
        if (add > -1.0e20) {
            for (uint k = 0u; k < 8u; k++)
                dot += q[k] * comp_at(cbase + lane + 64u * k);
        }
        dot = wave_sum_exact(dot, lane);
        if (lane == 0u)
            score[pc.n_raw + c] = add <= -1.0e20 ? -1.0e30 : dot * scale + add;
    }
    barrier();

    const uint total = pc.n_raw + pc.n_comp;
    float lane_max = sink_val[head];
    for (uint i = lane; i < total; i += 64u)
        if (i < pc.n_raw || score[i] > -1.0e20) lane_max = max(lane_max, score[i]);
    lane_max = wave_max_exact(lane_max, lane);
    const float max_score = subgroupShuffle(lane_max, 0u);
    for (uint i = lane; i < total; i += 64u)
        score[i] = (i >= pc.n_raw && score[i] <= -1.0e20) ?
            0.0 : exp(score[i] - max_score);
    barrier();

    float lane_denom = 0.0;
    for (uint i = lane; i < total; i += 64u) lane_denom += score[i];
    lane_denom = wave_sum_exact(lane_denom, lane);
    const float denom = exp(sink_val[head] - max_score) +
                        subgroupShuffle(lane_denom, 0u);

    float acc[8];
    for (uint k = 0u; k < 8u; k++) acc[k] = 0.0;
    /* Rows remain outermost, while each accumulator's raw-then-compressed
     * sequence is unchanged from the canonical dimension loop. */
    for (uint r = 0u; r < pc.n_raw; r++) {
        const uint kbase = add_mod(pc.raw_start, r, pc.raw_cap) * dim;
        const float weight = score[r];
        for (uint k = 0u; k < 8u; k++)
            acc[k] += weight * raw_val[kbase + lane + 64u * k];
    }
    for (uint c = 0u; c < pc.n_comp; c++) {
        const float add = pc.use_mask != 0u ? mask_val[c] : 0.0;
        if (add <= -1.0e20) continue;
        const float weight = score[pc.n_raw + c];
        const uint cbase = c * dim;
        for (uint k = 0u; k < 8u; k++)
            acc[k] += weight * comp_at(cbase + lane + 64u * k);
    }
    for (uint k = 0u; k < 8u; k++) acc[k] /= denom;

    for (uint k = 0u; k < 7u; k++)
        out_val[qbase + lane + 64u * k] = acc[k];
    if (pc.rope_enable != 0u && pc.n_rot != 0u &&
        (pc.n_rot & 1u) == 0u && pc.n_rot <= dim) {
        const uint pair_count = pc.n_rot / 2u;
        const uint rope_i = (lane & 31u) * 2u;
        const float rope_v0 = subgroupShuffle(acc[7], rope_i);
        const float rope_v1 = subgroupShuffle(acc[7], rope_i + 1u);
        if (lane < pair_count) {
            const uint i = lane * 2u;
            const float theta_extrap = float(pc.pos0) * pow(pc.freq_base,
                -float(i) / float(pc.n_rot));
            const float theta_interp = pc.freq_scale * theta_extrap;
            float theta = theta_interp;
            float mscale = pc.attn_factor;
            if (pc.ext_factor != 0.0) {
                const float denom2 = 2.0 * log(pc.freq_base);
                const float corr0 = max(0.0, floor(float(pc.n_rot) *
                    log(float(pc.n_ctx_orig) /
                        (pc.beta_fast * 2.0 * 3.141592653589793)) / denom2));
                const float corr1 = min(float(pc.n_rot - 1u), ceil(float(pc.n_rot) *
                    log(float(pc.n_ctx_orig) /
                        (pc.beta_slow * 2.0 * 3.141592653589793)) / denom2));
                const float mix = rope_ramp(corr0, corr1, lane) * pc.ext_factor;
                theta = theta_interp * (1.0 - mix) + theta_extrap * mix;
                mscale *= 1.0 + 0.1 * log(1.0 / pc.freq_scale);
            }
            const float two_pi = 6.283185307179586;
            theta -= round(theta / two_pi) * two_pi;
            const float cs = cos(theta) * mscale;
            const float sn = (pc.inverse != 0 ? -1.0 : 1.0) * sin(theta) * mscale;
            const uint tail = qbase + dim - pc.n_rot + i;
            out_val[tail] = rope_v0 * cs - rope_v1 * sn;
            out_val[tail + 1u] = rope_v0 * sn + rope_v1 * cs;
        }
    } else {
        out_val[qbase + lane + 448u] = acc[7];
    }
}
