#version 460 core
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer StateKV { float state_kv[]; };
layout(set = 0, binding = 1) buffer StateScore { float state_score[]; };
layout(set = 0, binding = 2) readonly buffer KV { float kv[]; };
layout(set = 0, binding = 3) readonly buffer Score { float score[]; };
layout(set = 0, binding = 4) readonly buffer Ape { uint ape[]; };
layout(push_constant) uniform PC {
    uint width;
    uint ratio;
    uint pos0;
    uint src0;
    uint dst0;
    uint rows;
    uint ape_type;
    uint reserved;
} pc;

float ape_value(uint index) {
    if (pc.ape_type == 0u) return uintBitsToFloat(ape[index]);
    return unpackHalf2x16(ape[index >> 1u])[index & 1u];
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = pc.rows * pc.width;
    if (gid >= total) return;
    uint row = gid / pc.width;
    uint j = gid - row * pc.width;
    uint src = pc.src0 + row;
    uint dst = pc.dst0 + row;
    uint phase = (pc.pos0 + src) % pc.ratio;
    state_kv[dst * pc.width + j] = kv[src * pc.width + j];
    state_score[dst * pc.width + j] =
        score[src * pc.width + j] + ape_value(phase * pc.width + j);
}