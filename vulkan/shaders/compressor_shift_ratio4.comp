#version 460 core
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer StateKV { float state_kv[]; };
layout(set = 0, binding = 1) buffer StateScore { float state_score[]; };
layout(push_constant) uniform PC { uint width; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = 4u * pc.width;
    if (i >= count) return;
    uint src = count + i;
    float kv = state_kv[src];
    float score = state_score[src];
    state_kv[i] = kv;
    state_score[i] = score;
    state_kv[src] = kv;
    state_score[src] = score;
}