#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer OutBlock { float out_val[]; };
layout(set = 0, binding = 1) readonly buffer ResidualBlock { float residual_val[]; };
layout(set = 0, binding = 2) readonly buffer WeightBlock { float weight_val[]; };

layout(push_constant) uniform PC {
    uint n_embd;
    uint n_hc;
    uint n_rows;
    uint reserved;
} pc;

void main() {
    uint d = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (d >= pc.n_embd || row >= pc.n_rows) return;

    float acc = 0.0;
    uint x_base = row * pc.n_hc * pc.n_embd;
    uint w_base = row * pc.n_hc;
    for (uint h = 0; h < pc.n_hc; ++h)
        acc += residual_val[x_base + h * pc.n_embd + d] * weight_val[w_base + h];
    out_val[row * pc.n_embd + d] = acc;
}