#version 460 core

/* Exact production top-512 for up to 4096 compressed rows.  This retains the
 * canonical comparator and bitonic network while distributing each stage
 * across four Wave64 subgroups instead of one. */
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer Selected { uint selected[]; };
layout(set = 0, binding = 1) readonly buffer Scores { float scores[]; };
layout(push_constant) uniform PC { uint n_comp; uint n_tokens; uint top_k; } pc;

const uint MAX_COMP = 4096u;
shared float sort_score[MAX_COMP];
shared uint sort_index[MAX_COMP];

bool score_better(float av, uint ai, float bv, uint bi) {
    if (isnan(av)) return isnan(bv) && ai < bi;
    if (isnan(bv)) return true;
    return av > bv || (av == bv && ai < bi);
}

void main() {
    const uint lane = gl_LocalInvocationIndex;
    const uint t = gl_WorkGroupID.x;
    if (t >= pc.n_tokens || pc.top_k > 512u || pc.n_comp > MAX_COMP) return;

    uint sort_size = 1u;
    while (sort_size < pc.n_comp) sort_size <<= 1u;
    for (uint c = lane; c < sort_size; c += 256u) {
        sort_score[c] = c < pc.n_comp
            ? scores[t * pc.n_comp + c]
            : uintBitsToFloat(0x7fc00000u);
        sort_index[c] = c < pc.n_comp ? c : 0xffffffffu;
    }
    barrier();

    for (uint span = 2u; span <= sort_size; span <<= 1u) {
        for (uint stride = span >> 1u; stride != 0u; stride >>= 1u) {
            for (uint i = lane; i < sort_size; i += 256u) {
                const uint other = i ^ stride;
                if (other > i) {
                    const float av = sort_score[i];
                    const uint ai = sort_index[i];
                    const float bv = sort_score[other];
                    const uint bi = sort_index[other];
                    const bool descending = (i & span) == 0u;
                    const bool swap = descending
                        ? score_better(bv, bi, av, ai)
                        : score_better(av, ai, bv, bi);
                    if (swap) {
                        sort_score[i] = bv;
                        sort_index[i] = bi;
                        sort_score[other] = av;
                        sort_index[other] = ai;
                    }
                }
            }
            barrier();
        }
    }
    for (uint k = lane; k < pc.top_k; k += 256u)
        selected[t * pc.top_k + k] = sort_index[k];
}
