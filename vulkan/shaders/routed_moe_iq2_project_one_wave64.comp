#version 460 core
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

/* Split projection candidate.  One launch computes either gate or up, so no
 * invocation carries both decode accumulators or both IQ2 payload streams.
 * Eight rows are covered by two Wave64 subgroups; each row's 16 lanes own
 * consecutive Q8_K blocks and reduce with the same FP32 XOR tree as the
 * paired appliance. */
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer B0 { uint b0[]; };
layout(set = 0, binding = 1) readonly buffer B1 { uint b1[]; };
layout(set = 0, binding = 2) readonly buffer B2 { uint b2[]; };
layout(set = 0, binding = 3) buffer B3 { uint b3[]; };
layout(set = 0, binding = 4) readonly buffer B4 { uint b4[]; };

layout(push_constant) uniform PC {
    uint mode;
    uint gate_type;
    uint down_type;
    uint in_dim;
    uint mid_dim;
    uint out_dim;
    uint n_tokens;
    uint n_selected;
    uint n_total_expert;
    uint gate_expert_bytes;
    uint gate_row_bytes;
    uint down_expert_bytes;
    uint down_row_bytes;
    uint q8_blocks;
    float clamp_value;
    uint add_enabled;
    uint q2_words;
} pc;

shared uint iq2_lut[544];
shared uint q8_cache[1168];

uint weight_u32(uint byte_idx) {
    uint word_idx = byte_idx >> 2u;
    uint shift = (byte_idx & 3u) * 8u;
    uint lo = b1[word_idx];
    if (shift == 0u) return lo;
    return (lo >> shift) | (b1[word_idx + 1u] << (32u - shift));
}

int packed_i8(uint word, uint byte_idx) {
    return bitfieldExtract(int(word), int((byte_idx & 3u) * 8u), 8);
}

float f16(uint value) { return unpackHalf2x16(value).x; }

void iq2_grid_words(uint index, out uint lo, out uint hi) {
    lo = iq2_lut[index * 2u];
    hi = iq2_lut[index * 2u + 1u];
}

uint iq2_sign_mask(uint index) {
    uint word = iq2_lut[512u + (index >> 2u)];
    return (word >> ((index & 3u) * 8u)) & 255u;
}

float iq2_block_dot(uint row_byte, uint block) {
    uint wb = row_byte + block * 66u;
    uint xb = block * 73u;
    float scale = uintBitsToFloat(q8_cache[xb]) * f16(weight_u32(wb) & 0xffffu);
    int sum = 0;
    for (uint ib = 0u; ib < 8u; ++ib) {
        uint qbase = wb + 2u + ib * 8u;
        uint q = weight_u32(qbase);
        uint aux = weight_u32(qbase + 4u);
        int ls = int(2u * (aux >> 28u) + 1u);
        for (uint pair = 0u; pair < 2u; ++pair) {
            uint q8_word = xb + 1u + ib * 8u + pair * 4u;
            uint q80_lo = q8_cache[q8_word];
            uint q80_hi = q8_cache[q8_word + 1u];
            uint q81_lo = q8_cache[q8_word + 2u];
            uint q81_hi = q8_cache[q8_word + 3u];
            uint s0 = (aux >> (14u * pair)) & 127u;
            uint s1 = (aux >> (14u * pair + 7u)) & 127u;
            uint g0 = (q >> (16u * pair)) & 255u;
            uint g1 = (q >> (16u * pair + 8u)) & 255u;
            uint g0l, g0h, g1l, g1h;
            iq2_grid_words(g0, g0l, g0h);
            iq2_grid_words(g1, g1l, g1h);
            uint signs0 = iq2_sign_mask(s0);
            uint signs1 = iq2_sign_mask(s1);
            for (uint j = 0u; j < 8u; ++j) {
                int q80 = packed_i8(j < 4u ? q80_lo : q80_hi, j);
                int q81 = packed_i8(j < 4u ? q81_lo : q81_hi, j);
                int v0 = packed_i8(j < 4u ? g0l : g0h, j);
                int v1 = packed_i8(j < 4u ? g1l : g1h, j);
                if ((signs0 & (1u << j)) != 0u) v0 = -v0;
                if ((signs1 & (1u << j)) != 0u) v1 = -v1;
                sum += ls * (v0 * q80 + v1 * q81);
            }
        }
    }
    return 0.125 * scale * float(sum);
}

void reduce_sum(inout float value) {
    uint lane = gl_SubgroupInvocationID & 15u;
    for (uint stride = 8u; stride != 0u; stride >>= 1u) {
        float peer = subgroupShuffleXor(value, stride);
        if (lane < stride) value += peer;
    }
}

void main() {
    uint lid = gl_LocalInvocationIndex;
    uint token = gl_WorkGroupID.y;
    uint rank = gl_WorkGroupID.z;
    if (token >= pc.n_tokens || rank >= pc.n_selected) return;
    uint logical_id = gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID;
    uint lane = logical_id & 15u;
    uint row = gl_WorkGroupID.x * 8u + (logical_id >> 4u);
    for (uint i = lid; i < pc.q8_blocks * 73u; i += 128u)
        q8_cache[i] = b0[token * pc.q8_blocks * 73u + i];
    for (uint i = lid; i < 544u; i += 128u) iq2_lut[i] = b4[i];
    barrier();
    uint expert = b2[token * pc.n_selected + rank];
    uint at = (token * pc.n_selected + rank) * pc.mid_dim + row;
    if (row >= pc.mid_dim) return;
    float value = 0.0;
    if (expert < pc.n_total_expert) {
        uint row_byte = expert * pc.gate_expert_bytes + row * pc.gate_row_bytes;
        value = iq2_block_dot(row_byte, lane);
        reduce_sum(value);
        if (lane == 0u && pc.clamp_value > 1.0e-6) {
            value = pc.add_enabled == 0u
                ? min(value, pc.clamp_value)
                : clamp(value, -pc.clamp_value, pc.clamp_value);
        }
    }
    if (lane == 0u) b3[at] = floatBitsToUint(value);
}
