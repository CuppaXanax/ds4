#version 460 core
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer RawBuf { float raw_val[]; };
layout(set = 0, binding = 1) readonly buffer KvBuf { float kv_val[]; };
layout(push_constant) uniform PC { uint raw_cap; uint pos0; uint n_tokens; uint head_dim; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = pc.n_tokens * pc.head_dim;
    if (i >= count) return;
    uint token = i / pc.head_dim;
    uint dim = i - token * pc.head_dim;
    uint row = (pc.pos0 + token) % pc.raw_cap;
    raw_val[row * pc.head_dim + dim] = unpackHalf2x16(packHalf2x16(vec2(kv_val[i], 0.0))).x;
}